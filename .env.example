# Where the app finds the backend. This is built into the app when it is
# bundled, so change it BEFORE building or starting Expo.
#  - Simulator or web on this Mac:  http://localhost:3000
#  - A real phone on the same Wi-Fi: "localhost" would be the phone itself.
#    Use this Mac's network name or address instead, e.g.
#      http://Your-Mac.local:3000     (name: scutil --get LocalHostName)
#      http://192.168.1.20:3000       (address: ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Only for installing on your own iPhone from Xcode (see app.config.js).
# A bundle identifier of your own, and optionally your Apple team id.
IOS_BUNDLE_ID=
APPLE_TEAM_ID=

# The staff browser tests read the staff sign-in from backend/.env, or from
# here. The backend also falls back to this file for anything backend/.env
# does not set. Nothing in this file is a working password.
STAFF_USERNAME=staff
STAFF_PASSWORD=
