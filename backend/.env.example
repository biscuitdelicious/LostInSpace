DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lis
PORT=3000
STAFF_USERNAME=staff
STAFF_PASSWORD=replace-with-staff-password
# Signs the "this phone signed in before" tokens that let known staff phones
# skip the shared wrong-password wait. Any long random string, e.g.
# `openssl rand -base64 32`. If unset, a random one is used per restart.
STAFF_DEVICE_SECRET=replace-with-a-long-random-string
