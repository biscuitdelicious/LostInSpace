# Copy to backend/.env and fill in the empty values. Nothing in this file is
# a working password: the backend and `docker compose` both refuse to start
# until you set your own. Generate one with:  openssl rand -hex 24

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
# Required. Used by `docker compose up` for a new database and by the backend.
DB_PASSWORD=
DB_NAME=lis
PORT=3000

# The staff sign-in for the #staff pages. Leave STAFF_PASSWORD empty and no
# staff account is created.
STAFF_USERNAME=staff
STAFF_PASSWORD=

# Signs the "this phone signed in before" tokens that let known staff phones
# skip the shared wrong-password wait. Any long random string, e.g.
# `openssl rand -base64 32`. If empty, a random one is used per restart.
STAFF_DEVICE_SECRET=
